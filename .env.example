# NavaCity backend configuration (copy to ".env" and adjust).
#
# Every variable is optional: the project runs with the defaults below.
# The file is read by pydantic-settings (see backend/app/config.py).

# --------------------------------------------------------------------------
# Authority authentication
# --------------------------------------------------------------------------
# "local" accepts the demo password "dumpme"; "production" refuses it and
# refuses to start the server without a properly configured password.
NAVACITY_ENV=local

# The password of the transport authority.  It is never stored: only a
# PBKDF2-HMAC-SHA256 hash of it is kept in memory.
#
# LOCAL DEMO DEFAULT ONLY - the line below is commented out on purpose, so
# that a copied ".env" does not ship a working credential.  Uncomment it and
# replace the value with your own password before you start the server.
# NAVACITY_AUTH_PASSWORD=dumpme

# Alternatively, supply a "salt_hex:hash_hex" pair instead of the plain
# password (generate it with:
#   python -c "from backend.app.security import hash_password; s,h=hash_password('your-password'); print(f'{s}:{h}')"
# )
# NAVACITY_AUTH_PASSWORD_HASH=

# Lifetime of an authority session, in minutes.
NAVACITY_AUTH_SESSION_MINUTES=60

# The HMAC secret used to sign the session tokens.  Leave it empty to get a
# random secret at start-up (restarting the server then invalidates all
# existing sessions).
# NAVACITY_AUTH_SECRET=

# --------------------------------------------------------------------------
# Paths and network
# --------------------------------------------------------------------------
# NAVACITY_DB_PATH=data/navacity.db
# NAVACITY_DATASET_CSV=data/generated/navacity_transport.csv
# NAVACITY_MODEL_BUNDLE=ml/artifacts/model_bundle.joblib
# NAVACITY_METRICS_JSON=ml/artifacts/metrics.json
# NAVACITY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
